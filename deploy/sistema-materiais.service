[Unit]
Description=Sistema de Gestão de Materiais (ASP.NET Core)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sistema-materiais
Group=sistema-materiais
WorkingDirectory=/opt/sistema-materiais/current
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5082
Environment=HOME=/var/lib/sistema-materiais
EnvironmentFile=/etc/sistema-materiais/app.env
EnvironmentFile=-/etc/sistema-materiais/bootstrap.env
ExecStart=/usr/bin/dotnet /opt/sistema-materiais/current/SistemaMateriais.Web.dll
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=sistema-materiais
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sistema-materiais

[Install]
WantedBy=multi-user.target
