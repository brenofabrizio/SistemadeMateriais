<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1769e0" />
    <title>@ViewData["Title"] — Gestão de Materiais</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaMateriais.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    }
    <a class="skip-link" href="#main-content">Ir para o conteúdo principal</a>
    <div class="app-shell">
        <aside class="sidebar d-none d-lg-flex" aria-label="Menu lateral">
            <a class="sidebar-brand" asp-area="" asp-page="/Index">
                <span class="brand-mark" aria-hidden="true">M</span>
                <span>Gestão de Materiais</span>
            </a>
            <nav class="sidebar-nav" aria-label="Navegação principal">
                <span class="nav-group">ESTOQUE</span>
                <a class="nav-link @(currentPage == "/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Index" aria-current="@(currentPage == "/Index" ? "page" : null)"><span aria-hidden="true">▦</span> Painel</a>
                <a class="nav-link @(currentPage == "/Categorias/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Categorias/Index" aria-current="@(currentPage == "/Categorias/Index" ? "page" : null)"><span aria-hidden="true">▤</span> Categorias</a>
                <a class="nav-link @(currentPage == "/Materiais/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Materiais/Index" aria-current="@(currentPage == "/Materiais/Index" ? "page" : null)"><span aria-hidden="true">▣</span> Materiais</a>
                <a class="nav-link @(currentPage == "/Ativos/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Ativos/Index" aria-current="@(currentPage == "/Ativos/Index" ? "page" : null)"><span aria-hidden="true">⌑</span> Ativos individualizados</a>
                <a class="nav-link @(currentPage == "/Movimentacoes/Entrada" ? "active" : string.Empty)" asp-area="" asp-page="/Movimentacoes/Entrada" aria-current="@(currentPage == "/Movimentacoes/Entrada" ? "page" : null)"><span aria-hidden="true">↕</span> Registrar entrada</a>
                    <a class="nav-link @(currentPage == "/Movimentacoes/Saida" ? "active" : string.Empty)" asp-area="" asp-page="/Movimentacoes/Saida" aria-current="@(currentPage == "/Movimentacoes/Saida" ? "page" : null)"><span aria-hidden="true">↘</span> Registrar consumo</a>
                    <a class="nav-link @(currentPage == "/Emprestimos/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Emprestimos/Index" aria-current="@(currentPage == "/Emprestimos/Index" ? "page" : null)"><span aria-hidden="true">↔</span> Empréstimos</a>
                    <a class="nav-link @(currentPage == "/Ajustes/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Ajustes/Index" aria-current="@(currentPage == "/Ajustes/Index" ? "page" : null)"><span aria-hidden="true">±</span> Ajustes de estoque</a>
                <a class="nav-link @(currentPage == "/Movimentacoes/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Movimentacoes/Index" aria-current="@(currentPage == "/Movimentacoes/Index" ? "page" : null)"><span aria-hidden="true">⌕</span> Histórico</a>
            </nav>
            <div class="sidebar-footer">Piloto · Setor de TI</div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <button class="menu-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Abrir menu">☰</button>
                <h1>@ViewData["Title"]</h1>
                <partial name="_LoginPartial" />
            </header>
            <div class="offcanvas offcanvas-start mobile-nav" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavTitle">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title" id="mobileNavTitle">Gestão de Materiais</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar menu"></button>
                </div>
                <nav class="offcanvas-body sidebar-nav" aria-label="Navegação principal">
                    <span class="nav-group">ESTOQUE</span>
                    <a class="nav-link @(currentPage == "/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Index" aria-current="@(currentPage == "/Index" ? "page" : null)"><span aria-hidden="true">▦</span> Painel</a>
                    <a class="nav-link @(currentPage == "/Categorias/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Categorias/Index" aria-current="@(currentPage == "/Categorias/Index" ? "page" : null)"><span aria-hidden="true">▤</span> Categorias</a>
                <a class="nav-link @(currentPage == "/Materiais/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Materiais/Index" aria-current="@(currentPage == "/Materiais/Index" ? "page" : null)"><span aria-hidden="true">▣</span> Materiais</a>
                <a class="nav-link @(currentPage == "/Ativos/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Ativos/Index" aria-current="@(currentPage == "/Ativos/Index" ? "page" : null)"><span aria-hidden="true">⌑</span> Ativos individualizados</a>
                    <a class="nav-link @(currentPage == "/Movimentacoes/Entrada" ? "active" : string.Empty)" asp-area="" asp-page="/Movimentacoes/Entrada" aria-current="@(currentPage == "/Movimentacoes/Entrada" ? "page" : null)"><span aria-hidden="true">↕</span> Registrar entrada</a>
                    <a class="nav-link @(currentPage == "/Movimentacoes/Saida" ? "active" : string.Empty)" asp-area="" asp-page="/Movimentacoes/Saida" aria-current="@(currentPage == "/Movimentacoes/Saida" ? "page" : null)"><span aria-hidden="true">↘</span> Registrar consumo</a>
                    <a class="nav-link @(currentPage == "/Emprestimos/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Emprestimos/Index" aria-current="@(currentPage == "/Emprestimos/Index" ? "page" : null)"><span aria-hidden="true">↔</span> Empréstimos</a>
                    <a class="nav-link @(currentPage == "/Ajustes/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Ajustes/Index" aria-current="@(currentPage == "/Ajustes/Index" ? "page" : null)"><span aria-hidden="true">±</span> Ajustes de estoque</a>
                    <a class="nav-link @(currentPage == "/Movimentacoes/Index" ? "active" : string.Empty)" asp-area="" asp-page="/Movimentacoes/Index" aria-current="@(currentPage == "/Movimentacoes/Index" ? "page" : null)"><span aria-hidden="true">⌕</span> Histórico</a>
                </nav>
            </div>
            <main id="main-content" class="page-content" role="main" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
